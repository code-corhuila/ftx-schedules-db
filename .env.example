# Local development values for this repository only. No real secrets here.
# Copy to .env before running docker compose:
#   cp .env.example .env          (Windows: copy .env.example .env)
# .env is ignored by git. Values for qa and prod live in ftx-infra, never here.

SCHEDULES_DB_NAME=schedules_db
SCHEDULES_DB_USER=schedules_user
SCHEDULES_DB_PASSWORD=change-me-local

# Port on your machine. Change it if it is already in use.
SCHEDULES_DB_HOST_PORT=5436
